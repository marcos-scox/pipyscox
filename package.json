    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/share": "8.0.3",
    "@capgo/capacitor-printer": "8.1.7"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "esbuild": "^0.25.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
